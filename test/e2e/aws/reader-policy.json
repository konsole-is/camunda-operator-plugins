{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HubRoles",
      "Effect": "Allow",
      "Action": ["iam:GetRole"],
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${RUN_ID}-hub-*"
    },
    {
      "Sid": "Buckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::${RUN_ID}-*"
    },
    {
      "Sid": "Keys",
      "Effect": "Allow",
      "Action": ["kms:DescribeKey"],
      "Resource": "arn:aws:kms:${AWS_REGION}:${AWS_ACCOUNT_ID}:key/*"
    }
  ]
}
